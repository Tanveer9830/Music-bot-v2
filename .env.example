# ==========================================================================
#  TANVEER MUSIC BOT V3 — Environment Template
#  Made by Tanveer  ·  Discord: tanveer5637
# ==========================================================================
#
#  HOW TO USE
#    1. Copy this file:            cp .env.example .env
#    2. Fill in the values below.
#    3. Lock the file down:        chmod 600 .env
#
#  The installer (./install.sh) does all of this for you interactively.
#
#  !! NEVER COMMIT THE .env FILE !!
#     .env is listed in .gitignore. If you ever paste a real token into a
#     chat, a screenshot, or a commit, rotate it immediately in the Discord
#     Developer Portal.
# ==========================================================================


# ── Discord (REQUIRED) ─────────────────────────────────────────────────────
# Bot token: Developer Portal → your app → Bot → Reset Token → Copy
# Treat this like a password. Never share it.
DISCORD_TOKEN=

# Application (Client) ID: Developer Portal → your app → General Information
DISCORD_CLIENT_ID=

# Optional. Paste a server ID to register slash commands instantly in that
# one server while testing. Leave blank to register globally (can take up
# to 1 hour to appear the first time).
DISCORD_GUILD_ID=


# ── Lavalink (REQUIRED for playback) ───────────────────────────────────────
# Hostname or IP of your Lavalink server.
# Use 127.0.0.1 when Lavalink runs on the same VPS as the bot.
LAVALINK_HOST=127.0.0.1

# Lavalink port (the default in Lavalink's own application.yml is 2333).
LAVALINK_PORT=2333

# Lavalink password — must match the `lavalink.server.password` value in
# your Lavalink application.yml.
LAVALINK_PASSWORD=youshallnotpass

# Set to true ONLY when Lavalink is behind TLS (wss:// / https://).
LAVALINK_SECURE=false

# Friendly label for this node, shown in the bot's startup logs.
LAVALINK_NAME=Main Node


# ── Spotify (OPTIONAL) ─────────────────────────────────────────────────────
# Only needed if you want users to paste open.spotify.com links.
# Create an app at https://developer.spotify.com/dashboard to get these.
# Leave BOTH blank to disable Spotify resolution cleanly.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


# ── Appearance (OPTIONAL) ──────────────────────────────────────────────────
# Embed accent colour — any hex colour.
EMBED_COLOR=#7B2FBE

# Embed footer text. The creator credit is appended automatically, so you
# normally do not need to change this.
FOOTER_TEXT=


# ── Runtime (OPTIONAL) ─────────────────────────────────────────────────────
# development | production
NODE_ENV=production

# 1 = force ANSI colours in logs, 0 = disable. Leave blank to auto-detect.
FORCE_COLOR=
